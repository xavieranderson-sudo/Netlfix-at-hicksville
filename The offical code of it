const moviesData = {
  trending: [],
  popular: [],
  topRated: [],
  upcoming: []
};

let currentMovie = null;

async function fetchMovies(endpoint) {
  if (!API_KEY || API_KEY === 'YOUR_TMDB_API_KEY_HERE') {
    return [];
  }

  const url = `${TMDB_BASE}/${endpoint}?api_key=${API_KEY}&language=en-US`;
  const response = await fetch(url);

  if (!response.ok) {
    throw new Error(`TMDb request failed: ${response.status}`);
  }

  const data = await response.json();
  return data.results || [];
}

async function fetchTrailerKey(movieId) {
  if (!API_KEY || API_KEY === 'YOUR_TMDB_API_KEY_HERE') return null;
  try {
    const res = await fetch(`${TMDB_BASE}/movie/${movieId}/videos?api_key=${API_KEY}&language=en-US`);
    if (!res.ok) return null;
    const data = await res.json();
    const ytTrailer = data.results.find(v => v.site === 'YouTube' && v.type === 'Trailer');
    const anyYouTube = data.results.find(v => v.site === 'YouTube');
    return (ytTrailer || anyYouTube)?.key || null;
  } catch (e) {
    return null;
  }
}

async function loadMovies() {
  try {
    const [trending, popular, topRated, upcoming] = await Promise.all([
      fetchMovies('trending/movie/day'),
      fetchMovies('movie/popular'),
      fetchMovies('movie/top_rated'),
      fetchMovies('movie/upcoming')
    ]);

    moviesData.trending = trending.length ? trending : defaultMoviesData.trending;
    moviesData.popular = popular.length ? popular : defaultMoviesData.popular;
    moviesData.topRated = topRated.length ? topRated : defaultMoviesData.topRated;
    moviesData.upcoming = upcoming.length ? upcoming : defaultMoviesData.upcoming;
  } catch (error) {
    console.warn('Using fallback data because TMDb is unavailable or key is missing.', error);
    Object.assign(moviesData, defaultMoviesData);
  }

  init();
}

// DOM Elements
const hero = document.getElementById('hero');
