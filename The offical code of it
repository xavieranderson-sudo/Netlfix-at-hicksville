function createMovieCard(movie) {
  const card = document.createElement('div');
  card.classList.add('movie-card');
  const posterPath = movie.poster_path ? IMAGE_BASE + movie.poster_path : 'https://via.placeholder.com/200x300/141414/e50914?text=No+Poster';
  const title = movie.title || 'Unknown';
  const rating = movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A';
  
  card.innerHTML = `
    <img src="${posterPath}" alt="${title}" loading="lazy" onerror="this.src='https://via.placeholder.com/200x300/141414/e50914?text=No+Poster'">
    <div class="card-info">
      <div class="card-title">${title}</div>
      <div class="card-rating">★ ${rating}</div>
    </div>
  `;
  card.addEventListener('click', () => openModal(movie));
  return card;
}

function renderRow(container, movies) {
  container.innerHTML = '';
  if (!movies || movies.length === 0) {
    container.innerHTML = '<div class="loading">No movies found</div>';
    return;
  }
  movies.forEach(movie => container.appendChild(createMovieCard(movie)));
}

function setHero(movie) {
  if (!movie) return;
  const backdrop = movie.backdrop_path ? BACKDROP_BASE + movie.backdrop_path : IMAGE_BASE + movie.poster_path;
  hero.style.backgroundImage = `linear-gradient(to right, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 50%, transparent 100%), url('${backdrop}')`;
  heroTitle.textContent = movie.title;
  heroOverview.textContent = movie.overview || 'No overview available.';
}

function openModal(movie) {
  currentMovie = movie;
  const posterPath = movie.poster_path ? IMAGE_BASE + movie.poster_path : 'https://via.placeholder.com/280x420/141414/e50914?text=No+Poster';
  document.getElementById('modalPoster').src = posterPath;
  document.getElementById('modalTitle').textContent = movie.title;
  document.getElementById('modalRating').textContent = `★ ${movie.vote_average?.toFixed(1) || 'N/A'}`;
  document.getElementById('modalYear').textContent = (movie.release_date || '').slice(0, 4);
  document.getElementById('modalOverview').textContent = movie.overview || 'No overview available.';
  modal.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeModalFunc() {
  modal.classList.remove('active');
  document.body.style.overflow = '';
}

closeModal.addEventListener('click', closeModalFunc);
modal.addEventListener('click', (e) => { if (e.target === modal) closeModalFunc(); });

async function playMovie(movie) {
  // Try TMDb trailers (YouTube) if we have a key, otherwise fallback to sample video
  if (!movie) return;
  showPlayer();
  // clear container
  playerContainer.innerHTML = '';

  const tryKey = await fetchTrailerKey(movie.id);
  if (tryKey) {
    // embed YouTube
    const iframe = document.createElement('iframe');
    iframe.className = 'player-iframe';
    iframe.src = `https://www.youtube.com/embed/${tryKey}?autoplay=1&rel=0`;
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
    playerContainer.appendChild(iframe);
    return;
  }

  // No YouTube trailer available — use sample video
  const video = document.createElement('video');
  video.className = 'player-video';
  video.controls = true;
  video.autoplay = true;
  video.src = SAMPLE_VIDEO;
  playerContainer.appendChild(video);
}

function showPlayer() {
  playerModal.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function hidePlayer() {
  playerModal.classList.remove('active');
  // stop playback & cleanup
  const iframe = playerContainer.querySelector('iframe');
  const video = playerContainer.querySelector('video');
  if (iframe) iframe.src = '';
  if (video) { video.pause(); video.currentTime = 0; video.src = ''; }
  playerContainer.innerHTML = '';
  document.body.style.overflow = '';
}

closePlayer.addEventListener('click', hidePlayer);
playerModal.addEventListener('click', (e) => { if (e.target === playerModal) hidePlayer(); });

modalPlayBtn.addEventListener('click', () => playMovie(currentMovie));
heroPlayBtn.addEventListener('click', () => {
  const first = moviesData.trending[0] || moviesData.popular[0] || null;
  if (first) playMovie(first);
});

function performSearch(query) {
  if (!query.trim()) {
    searchResultsRow.style.display = 'none';
    return;
  }
  const q = query.toLowerCase().trim();
  const allMovies = [...moviesData.trending, ...moviesData.popular, ...moviesData.topRated, ...moviesData.upcoming];
  const unique = allMovies.filter((movie, index, self) => index === self.findIndex(m => m.id === movie.id));
  const results = unique.filter(movie => movie.title.toLowerCase().includes(q) || (movie.overview && movie.overview.toLowerCase().includes(q)));
  searchResultsRow.style.display = 'block';
  renderRow(searchResultsContainer, results);
  searchResultsRow.scrollIntoView({ behavior: 'smooth' });
}

searchBtn.addEventListener('click', () => performSearch(searchInput.value));
searchInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') performSearch(searchInput.value); });

window.addEventListener('scroll', () => {
  const navbar = document.querySelector('.navbar');
  if (window.scrollY > 50) navbar.classList.add('scrolled');
  else navbar.classList.remove('scrolled');
});

function init() {
  if (moviesData.trending.length > 0) setHero(moviesData.trending[0]);
  renderRow(trendingContainer, moviesData.trending);
  renderRow(popularContainer, moviesData.popular);
  renderRow(topRatedContainer, moviesData.topRated);
  renderRow(upcomingContainer, moviesData.upcoming);
}

loadMovies();
  </script>
</body>
